# Copy to .env and fill in. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Without a real DJANGO_SECRET_KEY (change-me doesn't count) the app refuses
# to start unless DJANGO_DEBUG=1.
DJANGO_SECRET_KEY=change-me

# Development only: enables tracebacks and static-file serving.
# Leave this out (or 0) on any deployed instance.
DJANGO_DEBUG=0

# Hostnames/IPs the app may be reached on (comma-separated), e.g.
# meals.example.com,192.168.0.10 — required once DJANGO_DEBUG is off.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Add e.g. https://meals.example.com when serving behind a proxy/domain
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to 1 when serving over HTTPS: session/CSRF cookies become TLS-only.
DJANGO_SECURE_COOKIES=0

# Set to 1 behind a proxy that ends TLS and always sets X-Forwarded-Proto.
DJANGO_BEHIND_TLS_PROXY=0

# The header with the visitor's address behind a proxy, for login rate limits:
# HTTP_X_FORWARDED_FOR behind Caddy. Only set it when the app's port can't be reached
# except through that proxy, or visitors can make up their own address.
DJANGO_CLIENT_IP_HEADER=

# Email for invitations and password resets. Without EMAIL_HOST, mails are only
# printed to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
