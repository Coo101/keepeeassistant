msgstr "Wachtwoord bewaard"

#: templates/registration/password_reset_complete.html
#, python-format
msgid ""
"You can now <a href=\"%(login_url)s\">log in</a> with your new password."
msgstr ""
"Je kunt nu <a href=\"%(login_url)s\">inloggen</a> met je nieuwe wachtwoord."

#: templates/registration/password_reset_confirm.html
msgid "Choose a new password"
msgstr "Kies een nieuw wachtwoord"

#: templates/registration/password_reset_confirm.html
msgid "Save password"
msgstr "Wachtwoord bewaren"

#: templates/registration/password_reset_confirm.html
#, python-format
msgid ""
"This link no longer works. <a href=\"%(reset_url)s\">Ask for a new one</a>."
msgstr ""
"Deze link werkt niet meer. <a href=\"%(reset_url)s\">Vraag een nieuwe</a>."

#: templates/registration/password_reset_done.html
msgid "Check your email"
msgstr "Kijk je mail na"

#: templates/registration/password_reset_done.html
msgid ""
"If an account uses that address, a link is on its way. It can take a few "
"minutes; check your spam folder too."
msgstr ""
"Als een account dat adres gebruikt, is er een link onderweg. Dat kan enkele "
"minuten duren; kijk ook in je spammap."

#: templates/registration/password_reset_email.html
#, python-format
msgid ""
"Someone asked to reset the password for your Camp Meal Planner account "
"(%(username)s)."
msgstr ""
"Iemand vroeg om het wachtwoord van je Kamp Maaltijd Planner-account "
"(%(username)s) opnieuw in te stellen."

#: templates/registration/password_reset_email.html
msgid "Choose a new password here:"
msgstr "Kies hier een nieuw wachtwoord:"

#: templates/registration/password_reset_email.html
msgid "If this wasn't you, you can ignore this mail."
msgstr "Was jij dit niet? Dan kun je deze mail negeren."

#: templates/registration/password_reset_form.html
msgid ""
"Enter the email address of your account and we'll send a link to choose a "
"new password."
msgstr ""
"Vul het e-mailadres van je account in en we sturen een link om een nieuw "
"wachtwoord te kiezen."

#: templates/registration/password_reset_form.html
msgid "Send link"
msgstr "Link versturen"

#: templates/registration/password_reset_subject.txt
msgid "Reset your Camp Meal Planner password"
msgstr "Stel je wachtwoord voor Kamp Maaltijd Planner opnieuw in"

